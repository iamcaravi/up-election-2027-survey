# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# database
*.db
*.db-journal

# Local database sidecars and alternate SQLite filenames
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Local agent launcher settings
/.claude/

# Safe environment template
!.env.example

# Local database backups/snapshots (never ship a DB dump)
*.db.backup
*.sqlite.backup
*.sqlite3.backup

# Local design-tool cache (21st.dev component tool)
/.21st/

# Raw source assets supplied for design work — not read by the app at
# runtime (served images live under public/images/); kept locally for
# reference, never committed.
/reference-images/

# Scratch output from one-off data-migration scripts (scripts/phase19-*.ts)
scripts/.out-*.json

# Local Netlify folder
.netlify
