// India Election Survey — Public Mood & Survey Platform
// Data model. Provider is SQLite for zero-config local development;
// switch `provider` to "postgresql" and point DATABASE_URL at a real
// Postgres instance for production (see README "Production database").
// Enum-like fields are plain Strings validated in the app layer (src/lib/enums.ts)
// so the same schema works unchanged on both SQLite and Postgres.
//
// Hierarchy: State -> Election -> District / Constituency -> Candidate / Survey.
// A Constituency belongs to a State (and District) independent of any one
// election; ElectionConstituency links a specific Election to the
// constituencies contested in it, so historical data never gets mixed across
// elections or states. Candidate and Survey are scoped to (Election, Constituency).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Geography / elections
// ---------------------------------------------------------------------------

model State {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  code      String   @unique // e.g. UP, MH
  shortName String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  elections     Election[]
  districts     District[]
  constituencies Constituency[]
  stateParties  StateParty[]

  @@map("states")
}

model Election {
  id            String    @id @default(cuid())
  stateId       String
  state         State     @relation(fields: [stateId], references: [id])
  name          String
  slug          String
  electionType  String    @default("ASSEMBLY") // ASSEMBLY | LOK_SABHA | LOCAL
  year          Int
  status        String    @default("UPCOMING") // UPCOMING | ONGOING | COMPLETED
  electionDate  DateTime?
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  electionConstituencies ElectionConstituency[]
  candidates             Candidate[]
  surveys                Survey[]

  @@unique([stateId, slug])
  @@index([stateId])
  @@map("elections")
}

model District {
  id        String   @id @default(cuid())
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  name      String
  slug      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  constituencies Constituency[]

  @@unique([stateId, slug])
  @@index([stateId])
  @@map("districts")
}

model Constituency {
  id              String   @id @default(cuid())
  stateId         String
  state           State    @relation(fields: [stateId], references: [id])
  districtId      String
  district        District @relation(fields: [districtId], references: [id])
  number          Int      // official AC number, unique within a state
  name            String
  slug            String
  type            String   @default("ASSEMBLY") // ASSEMBLY | LOK_SABHA
  reservedStatus  String   @default("None") // None | SC | ST
  currentMlaName  String?
  currentMlaParty String?
  result2022WinnerName  String?
  result2022WinnerParty String?
  result2022Margin      Int?
  result2022TurnoutPct  Float?
  historicalNotes String? // free text, source-cited
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  electionConstituencies ElectionConstituency[]
  candidates             Candidate[]
  surveys                Survey[]
  surveyResponses        SurveyResponse[]
  analyticsSnapshots     AnalyticsSnapshot[]

  @@unique([stateId, number])
  @@unique([stateId, slug])
  @@index([stateId])
  @@index([districtId])
  @@map("constituencies")
}

// Links a specific Election to the constituencies contested in it, so the
// same physical constituency can appear (or not) across different election
// cycles without corrupting historical data from other years.
model ElectionConstituency {
  id             String       @id @default(cuid())
  electionId     String
  election       Election     @relation(fields: [electionId], references: [id])
  constituencyId String
  constituency   Constituency @relation(fields: [constituencyId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([electionId, constituencyId])
  @@index([constituencyId])
  @@map("election_constituencies")
}

// ---------------------------------------------------------------------------
// Parties & Candidates
// ---------------------------------------------------------------------------

// A Party is a single global row (BJP/INC/AAP are the same row everywhere),
// shared across states via StateParty. logoUrl/nameHindi are plain nullable
// fields an admin fills in — no logo/Hindi name is ever invented in code; a
// party without one simply renders its English name / an initials fallback.
model Party {
  id          String   @id @default(cuid())
  nameEnglish String
  nameHindi   String?
  shortName   String   @unique // e.g. BJP, SP, INC, BSP
  slug        String   @unique
  colorHex    String   @default("#6b7280")
  logoUrl     String?
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidates       Candidate[]
  surveyOptions    SurveyOption[]
  stateParties     StateParty[]

  @@map("parties")
}

// Which parties are "featured" (shown in the public survey) for a given
// state, and in what order. A national party (BJP/INC/AAP/...) gets one
// StateParty row per state it's featured in; a state-only party (e.g.
// Shiromani Akali Dal) simply never gets a row in any other state. The
// public survey's party question is built from `isFeatured: true` rows only
// (capped at 5 by the admin API) plus the three always-on globals
// (other/nota/undecided), which are NOT modeled here — see
// src/lib/survey-template-data.ts.
model StateParty {
  id           String   @id @default(cuid())
  stateId      String
  state        State    @relation(fields: [stateId], references: [id])
  partyId      String
  party        Party    @relation(fields: [partyId], references: [id])
  isFeatured   Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([stateId, partyId])
  @@index([stateId])
  @@index([partyId])
  @@map("state_parties")
}

model Candidate {
  id             String   @id @default(cuid())
  electionId     String
  election       Election @relation(fields: [electionId], references: [id])
  constituencyId String
  constituency   Constituency @relation(fields: [constituencyId], references: [id])
  partyId        String?
  party          Party?   @relation(fields: [partyId], references: [id])
  name           String
  nameHindi      String?  // Devanagari form, entered/verified by an admin — never machine-transliterated
  slug           String
  status         String   // DECLARED | LIKELY | POSSIBLE | INCUMBENT | HISTORICAL | OTHER
  confidenceScore String  @default("LOW") // HIGH | MEDIUM | LOW
  currentOffice  String?
  background     String?  // short political background, source-cited
  sourceNotes    String?
  sourceUrls     String?  // JSON-encoded string[]
  // Distinct from photoVerified (which covers only the photo). This means an
  // admin has checked the record's core facts (name/party/constituency/status)
  // against sourceNotes/sourceUrls — never set true by an automated import.
  verified       Boolean  @default(false)

  photoUrl          String?
  photoSourceUrl     String?
  photoSourceName    String?
  photoLicense       String?
  photoVerified      Boolean  @default(false)
  photoRetrievedAt   DateTime?

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  imageSources   ImageSource[]

  @@unique([electionId, constituencyId, slug])
  @@index([electionId])
  @@index([constituencyId])
  @@index([partyId])
  @@map("candidates")
}

model ImageSource {
  id             String   @id @default(cuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id])
  imageUrl       String
  sourceUrl      String
  sourceName     String
  license        String?
  status         String   @default("PENDING") // PENDING | VERIFIED | REJECTED | REPLACE
  reviewedBy     String?
  reviewedAt     DateTime?
  notes          String?
  retrievedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([candidateId])
  @@map("image_sources")
}

// ---------------------------------------------------------------------------
// Survey engine (generic, admin-editable questions/options)
// ---------------------------------------------------------------------------

model Survey {
  id             String   @id @default(cuid())
  electionId     String
  election       Election @relation(fields: [electionId], references: [id])
  constituencyId String?
  constituency   Constituency? @relation(fields: [constituencyId], references: [id])
  title          String
  description    String?
  type           String   @default("CONSTITUENCY") // CONSTITUENCY | STATEWIDE
  status         String   @default("ACTIVE") // ACTIVE | CLOSED | DRAFT
  isActive       Boolean  @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  minimumSampleSize Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  questions      SurveyQuestion[]
  responses      SurveyResponse[]

  @@index([electionId])
  @@index([constituencyId])
  @@map("surveys")
}

model SurveyQuestion {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id])
  key         String   // candidate_choice | party_preference | top_issue | age_group | gender | social_category | religion
  label       String
  type        String   @default("SINGLE_CHOICE") // SINGLE_CHOICE | MULTIPLE_CHOICE | TEXT
  required    Boolean  @default(false)
  allowSkip   Boolean  @default(true)
  order       Int      @default(0)

  options     SurveyOption[]
  answers     SurveyAnswer[]

  @@unique([surveyId, key])
  @@map("survey_questions")
}

model SurveyOption {
  id          String   @id @default(cuid())
  questionId  String
  question    SurveyQuestion @relation(fields: [questionId], references: [id])
  key         String
  label       String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  candidateRef String? // optional linked candidate id (for candidate_choice questions)
  partyId     String?
  party       Party?   @relation(fields: [partyId], references: [id])

  answers     SurveyAnswer[]

  @@unique([questionId, key])
  @@map("survey_options")
}

model SurveyResponse {
  id             String   @id @default(cuid())
  surveyId       String
  survey         Survey   @relation(fields: [surveyId], references: [id])
  constituencyId String
  constituency   Constituency @relation(fields: [constituencyId], references: [id])
  status         String   @default("VALID") // VALID | FLAGGED | REJECTED
  ipHash         String?  // salted hash, never raw IP
  fingerprint    String?  // salted device/browser fingerprint hash
  flagReason     String?
  createdAt      DateTime @default(now())
  // "real" (an actual submitted survey response) or "synthetic_demo" (admin-
  // generated demo/testing data — see src/lib/synthetic-data.ts). Public
  // aggregation queries always filter on this field so demo data can never
  // silently mix with genuine responses.
  dataSource     String   @default("real")

  answers        SurveyAnswer[]
  moderationFlags ModerationFlag[]

  @@index([surveyId])
  @@index([constituencyId])
  @@index([fingerprint])
  @@index([createdAt])
  @@index([dataSource])
  @@map("survey_responses")
}

model SurveyAnswer {
  id          String   @id @default(cuid())
  responseId  String
  response    SurveyResponse @relation(fields: [responseId], references: [id])
  questionId  String
  question    SurveyQuestion @relation(fields: [questionId], references: [id])
  optionId    String?
  option      SurveyOption?  @relation(fields: [optionId], references: [id])
  valueText   String?

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
  @@map("survey_answers")
}

model AnalyticsSnapshot {
  id             String   @id @default(cuid())
  constituencyId String
  constituency   Constituency @relation(fields: [constituencyId], references: [id])
  computedAt     DateTime @default(now())
  payload        String   // JSON-encoded aggregate result (candidate %, party %, issues, demographics)

  @@index([constituencyId, computedAt])
  @@map("analytics_snapshots")
}

model ModerationFlag {
  id          String   @id @default(cuid())
  responseId  String
  response    SurveyResponse @relation(fields: [responseId], references: [id])
  reason      String
  severity    String   @default("LOW") // LOW | MEDIUM | HIGH
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([responseId])
  @@map("moderation_flags")
}

// ---------------------------------------------------------------------------
// Admin & platform
// ---------------------------------------------------------------------------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("EDITOR") // ADMIN | EDITOR | MODERATOR
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  auditLogs    AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id           String   @id @default(cuid())
  adminUserId  String?
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id])
  action       String
  entityType   String
  entityId     String?
  metadata     String?  // JSON-encoded
  createdAt    DateTime @default(now())

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SiteSetting {
  key         String   @id
  value       String   // JSON-encoded
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

// Anonymous footer visitor-analytics. `visitorHash` is a salted one-way hash
// (see src/lib/hash.ts) of the same random device identifier already used
// for survey duplicate-detection (src/lib/fingerprint.ts) — no new tracking
// surface, no raw identifier or IP ever stored. One row per unique visitor
// ever seen: `firstSeenAt` never changes (so COUNT(*) is the lifetime unique
// visitor total), `lastSeenAt` is bumped on every heartbeat (so "live now" is
// COUNT(*) WHERE lastSeenAt >= now - window, with no separate expiry job —
// a row simply ages out of the live window on its own without being deleted).
model VisitorPresence {
  visitorHash String   @id
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
  @@map("visitor_presence")
}

// Admin-managed public FAQ content (see src/app/faq/page.tsx and
// src/app/admin/faq). Separate from SiteSetting's generic key/value blobs
// because FAQ needs real per-row querying/ordering (filter by published,
// order by category + displayOrder) rather than one opaque JSON document.
// categoryLabel is intentionally denormalized onto each row (no separate
// FaqCategory table) — the category list here is small and admin-curated,
// not worth a second table + join for this scale.
model FaqItem {
  id            String   @id @default(cuid())
  category      String
  categoryLabel String
  question      String
  answer        String
  // Optional Hindi counterparts — additive, nullable columns so every
  // existing row (seeded in English from src/lib/faq-data.ts, or whatever
  // language an admin has since entered in the primary fields above) is
  // preserved unchanged. Named *Hi rather than *En to match this codebase's
  // existing convention (Party's base fields are English with an optional
  // nameHindi overlay — see src/lib/party-logos.ts) and the FAQ CMS's
  // actual current data, which is English in the primary fields. The
  // public FAQ page prefers these when locale=hi and they are filled in;
  // otherwise it falls back to the primary (English) fields (see
  // loadPublishedFaqCategories) — same fallback pattern as Party.nameHindi.
  categoryLabelHi String?
  questionHi      String?
  answerHi        String?
  displayOrder  Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     String?

  @@index([category, displayOrder])
  @@map("faq_items")
}

// A snapshot taken immediately before every FaqItem update/delete — the
// lightweight version history required for admin rollback. Rows survive
// their parent FaqItem's deletion (faqItemId then points at nothing live),
// which is intentional: it's still a legitimate historical record of what
// that question/answer used to say.
model FaqItemVersion {
  id         String   @id @default(cuid())
  faqItemId  String
  category   String
  question   String
  answer     String
  questionHi String?
  answerHi   String?
  createdAt  DateTime @default(now())
  createdBy  String?

  @@index([faqItemId, createdAt])
  @@map("faq_item_versions")
}

// Generalizes FaqItem/FaqItemVersion's draft/publish/version pattern to any
// single-identity editable content "slot" (a legal page, a nav label, a
// homepage text block) instead of hand-rolling a new model pair per content
// type — see src/lib/content-blocks.ts. publishedValue is always what the
// public site renders; draftValue is only ever visible through an
// admin-only preview and is never read by a public page directly.
// contentType is a free-form discriminator ("plainText" | "richText" |
// "structuredSections" | "json") interpreted by the admin UI/consumer, not
// enforced at the DB layer.
model ContentBlock {
  id             String    @id @default(cuid())
  slotKey        String    @unique
  contentType    String
  draftValue     String?
  publishedValue String
  status         String    @default("PUBLISHED") // DRAFT_ONLY | PUBLISHED | HAS_DRAFT
  updatedAt      DateTime  @updatedAt
  updatedBy      String?
  publishedAt    DateTime?

  @@map("content_blocks")
}

// A snapshot of publishedValue taken at PUBLISH time (not on every draft
// save — avoids version-spam from autosave/iterative editing). Rows survive
// their parent ContentBlock (there isn't a hard FK) for the same reason
// FaqItemVersion survives a deleted FaqItem: it's still a legitimate
// historical record.
model ContentBlockVersion {
  id        String   @id @default(cuid())
  slotKey   String
  value     String
  createdAt DateTime @default(now())
  createdBy String?

  @@index([slotKey, createdAt])
  @@map("content_block_versions")
}

// Generic admin media library (Admin → Media Library) — additive, does not
// replace any existing feature-specific upload route (Hero background,
// Survey Hero elements, candidate ImageSource). Files live under
// public/uploads/media/<generated-name> with the same magic-number
// validation pattern already used by those existing upload routes.
model MediaAsset {
  id         String   @id @default(cuid())
  url        String
  fileName   String
  mimeType   String
  sizeBytes  Int
  altText    String?
  caption    String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@map("media_assets")
}

// Per-page SEO overrides, keyed by the exact relative path buildPageMetadata()
// already builds canonical/OG URLs from (src/lib/seo.ts). A missing row for
// a path means "use the generated default" — see src/lib/seo-overrides.ts's
// applySeoOverride(), which only replaces fields explicitly set here and
// never touches canonical-URL construction itself.
model SeoOverride {
  path           String    @id
  title          String?
  description    String?
  ogImageAssetId String?
  noindex        Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
  updatedBy      String?

  @@map("seo_overrides")
}
